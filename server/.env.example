# Copia este archivo a ".env" y rellena tus valores reales antes de arrancar el servidor.
# NUNCA subas el archivo ".env" real a git (ya está ignorado en .gitignore).

PORT=3000

# Dominio(s) permitido(s) para llamadas desde el frontend si lo despliegas por separado.
# Usa "*" en pruebas; en producción pon tu dominio real, p. ej. https://www.kaelaut.com
ALLOWED_ORIGIN=*

# --- Envío de emails (SMTP) ---
# Puedes usar Gmail (con contraseña de aplicación), Brevo, Resend, SendGrid, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=cambia-esto
MAIL_FROM="KAEL AUT <notificaciones@kaelaut.com>"

# --- Panel de administración (backoffice) ---
# Acceso a GET /api/admin/solicitudes y /admin.html mediante autenticación básica.
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contrasena

# --- Empresas náuticas: email de contacto de cada una ---
# No hay empresas colaboradoras confirmadas todavía. Al añadir una empresa
# real en js/data.js (COMPANIES) y en server/server.js (COMPANIES), añade
# aquí su variable de email, p. ej.:
# COMPANY_EMAIL_NOMBRE_EMPRESA=reservas@nombreempresa.example
